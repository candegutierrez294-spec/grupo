
#progreso {
    background: #f3eaff;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 20px;
}

#progreso h3 {
    margin-top: 0;
    color: #6b35a8;
}

#resumen {
    font-size: 14px;
    color: #555;
}

.barra-fondo {
    width: 100%;
    height: 12px;
    background: #ddd0f5;
    border-radius: 20px;
    overflow: hidden;
}

#barra {
    width: 0%;
    height: 100%;
    background: #8b5cf6;
    border-radius: 20px;
    transition: width 0.4s ease;
}

.estadisticas {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
